#!/usr/bin/env bash
#
# Script to create a bootable CD image file containing BOOT.
# Usage:
#
#   ./mkcdimage {version}
#
# where {version} is the BOOT version number.
#
# This script relies on the mcopy utility.
#
# The script creates an image file from the binary package
# stored in ../snapshots/{version}/boot-bin-{version}.zip
# The resulting CD image file is stored in
# ../snapshots/{version}/boot-cd-{version}.iso

StartDir=$(pwd)
Version=$1

# Unzip the binary archive file....
cd ../snapshots/"$Version" || exit
rm -rf temp
mkdir temp
cd temp || exit
unzip ../boot-bin-"$Version".zip
cp "$StartDir"/SHELLS.txt ./boot-bin-"$Version"

# Create a boot directory and (temporarily) copy the EFI shell
# files to it....
mkdir -p boot-bin-"$Version"/EFI/boot
cd boot-bin-"$Version"/EFI/boot || exit
#cp $StartDir/shell*.efi ./

# Create hard links to the BOOT files so that they'll be suitable for an
# EFI-boot CD...
ln ../../boot/boot_ia32.efi ./bootia32.efi
ln ../../boot/boot_x64.efi ./bootx64.efi
ln ../../boot/boot_aa64.efi ./bootaa64.efi
cp ../../boot/boot.conf-sample ./boot.conf
cp ../../boot/boot.conf-sample ./boot.conf-sample
sed -i '/#showtools/a showtools shell,memtest,gdisk,apple_recovery,csr_rotate,windows_recovery,mok_tool,about,shutdown,reboot,firmware' boot.conf
sed -i '/#csr_values/a csr_values 10,77' boot.conf
sed -i '/#csr_values/a csr_values 10,77' boot.conf
sed -i 's/^showtools shell/showtools install,bootorder,shell/g' boot.conf
mkdir icons
(
cd icons || exit
ln ../../../boot/icons/* ./
)
mkdir drivers_x64
(
cd drivers_x64 || exit
ln ../../../boot/drivers_x64/* ./
)
mkdir drivers_ia32
cd drivers_ia32 || exit
ln ../../../boot/drivers_ia32/* ./
cd ..
mkdir drivers_aa64
cd drivers_aa64 || exit
ln ../../../boot/drivers_aa64/* ./
cd ../.. || exit

# Copy stuff to the EFI/tools directory
mkdir tools
cd tools || exit
cp "$StartDir"/tools/*.efi ./
cp ../../../../temp/boot-bin-"$Version"/boot/tools*/*.efi ./
cd ../.. || exit

# Get the size of the binaries to go in the El Torito image in kB
ToritoSize=$(du -s EFI | cut -f 1)
((ToritoSize=ToritoSize/28))
((ToritoSize=ToritoSize*32))

# Move the EFI shell files back to the root where they belong
# (They were in EFI/boot just so they'd get counted in ToritoSize)
#mv EFI/boot/shell*.efi ./

# Prepare a FAT filesystem image and populate it with the
# EFI boot files....
dd if=/dev/zero of=boot-bin-"$Version".img bs=1024 count=$ToritoSize
mkdosfs -n "ElTorito" boot-bin-"$Version".img
mcopy -iboot-bin-"$Version".img -s EFI shell*.efi ::/

# Make the ISO-9660 image file....
mkisofs -A "Bootable BOOT" -V "BOOT_$Version" -volset "BOOT_$Version" \
    -J -r -v -x ./lost+found -o ../../boot-cd-"$Version".iso \
    -eltorito-alt-boot -efi-boot boot-bin-"$Version".img \
    -no-emul-boot ./

# Create a bootable USB flash drive image, using the FAT filesystem
# created above and a stored partition table image (plus some empty
# sectors)....
#
rm -f ../../boot-flashdrive-"$Version".*
((FatSize=$(du -s boot-bin-"$Version".img | cut -f 1)))
((FatSize=FatSize+2048))
dd if=/dev/zero of=../../boot-flashdrive-"$Version".img bs=1024 count="$FatSize"
if ! sgdisk -n 1:2048:0 -t 1:EF00 -g ../../boot-flashdrive-"$Version".img ; then
   echo "sgdisk failed! Exiting!"
   exit 1
fi
dosfslabel boot-bin-"$Version".img BOOT
dd if=boot-bin-"$Version".img of=../../boot-flashdrive-"$Version".img bs=512 seek=2048 conv=notrunc

cd ..
mkdir boot-flashdrive-"$Version"
ln ../boot-flashdrive-"$Version".img boot-flashdrive-"$Version"
cp "$StartDir"/README-flashdrive.txt "$StartDir"/COPYING.txt "$StartDir"/NEWS.txt \
   "$StartDir"/CREDITS.txt "$StartDir"/LICENSE.txt "$StartDir"/SHELLS.txt boot-flashdrive-"$Version"
zip -9r ../boot-flashdrive-"$Version".zip boot-flashdrive-"$Version"

cd ../

# Zip up the optical disc image....
rm -f boot-cd-"$Version".zip
zip -9 boot-cd-"$Version".zip boot-cd-"$Version".iso

rm -r temp/
