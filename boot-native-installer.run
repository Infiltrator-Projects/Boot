#!/usr/bin/env bash
# BOOT / Native source installer
#
# Fetches one pinned source revision, compiles CPU-native EFI images and
# invokes the fixed-directory installation flow.
#
# This program does not expose a build-only mode or an alternate ESP
# destination. Firmware registration and installation have effects beyond
# source compilation.

set -euo pipefail

SOURCE_SHA="__BOOT_SOURCE_COMMIT__"
RELEASE_VERSION="__BOOT_RELEASE_VERSION__"
SOURCE_URL='https://github.com/Infiltrator-Projects/Boot.git'

if (($# != 0)); then
    echo "BOOT native installer takes no arguments: running it builds and installs." >&2
    exit 2
fi
[[ $(uname -m) == x86_64 ]] || { echo "BOOT native installer requires x86-64" >&2; exit 2; }

if ((EUID != 0)); then
    command -v sudo >/dev/null || { echo "sudo is required for EFI installation" >&2; exit 1; }
    exec sudo bash "$0"
fi

required=(git make gcc ld objcopy tar mktemp efibootmgr findmnt lsblk blkid realpath od)
missing=()
for program in "${required[@]}"; do
    command -v "$program" >/dev/null 2>&1 || missing+=("$program")
done
if ((${#missing[@]})) || [[ ! -f /usr/include/efi/efi.h ]]; then
    echo "Missing BOOT native build prerequisites: ${missing[*]} (and/or gnu-efi headers)" >&2
    if ! command -v apt-get >/dev/null; then
        echo "Install build-essential, binutils, git and gnu-efi before running BOOT." >&2
        exit 1
    fi
    if ((EUID == 0)); then
        apt-get -o DPkg::Lock::Timeout=300 update
        apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends build-essential binutils git gnu-efi efibootmgr util-linux coreutils
    else
        command -v sudo >/dev/null || { echo "sudo is required to install build dependencies" >&2; exit 1; }
        sudo apt-get -o DPkg::Lock::Timeout=300 update
        sudo apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends build-essential binutils git gnu-efi efibootmgr util-linux coreutils
    fi
fi
for program in "${required[@]}"; do
    command -v "$program" >/dev/null || { echo "Still missing $program" >&2; exit 1; }
done
[[ -f /usr/include/efi/efi.h ]] || { echo "GNU-EFI headers are still missing" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
source_dir="$work/Boot"
git -C "$work" init -q Boot
git -C "$source_dir" remote add origin "$SOURCE_URL"
# Sparse checkout limits the materialised source directories. Fetch by the
# packaged object ID and verify the detached HEAD before compiling so a newer
# main cannot silently change what this installer builds.
git -C "$source_dir" sparse-checkout init --cone
git -C "$source_dir" sparse-checkout set boot EfiLib gzip libeg mok include icons fonts banners themes keys filesystems
git -C "$source_dir" -c protocol.version=2 fetch --quiet --depth 1 --filter=blob:none origin "$SOURCE_SHA"
git -C "$source_dir" -c advice.detachedHead=false checkout --quiet --detach FETCH_HEAD
[[ $(git -C "$source_dir" rev-parse HEAD) == "$SOURCE_SHA" ]] || {
    echo "BOOT source commit does not match the published installer" >&2; exit 1;
}
cd "$source_dir"
[[ -f Makefile && -f Make.common && -f boot/main.c ]] || {
    echo "Downloaded BOOT build source is incomplete" >&2; exit 1;
}
echo "Building BOOT natively from source commit $SOURCE_SHA..."
printf 'sbat,1,SBAT Version,sbat,1,https://github.com/rhboot/shim/blob/main/SBAT.md\nboot,1,Infiltrator-Projects,boot,%s,https://github.com/Infiltrator-Projects/Boot\n' "$RELEASE_VERSION" > boot-sbat-release.csv
make BOOT_SBAT_CSV=boot-sbat-release.csv CFLAGS="-O2 -march=native -mtune=native -mgeneral-regs-only -fno-stack-protector -fshort-wchar -fno-strict-aliasing -fno-tree-loop-distribute-patterns -Wall -DBOOT_RELEASE_VERSION='L\"$RELEASE_VERSION\"'" gnuefi
[[ -s boot/boot_x64.efi ]] || { echo "Native BOOT EFI build failed" >&2; exit 1; }
for filesystem in ext2 ext4 reiserfs iso9660 hfs btrfs; do
    [[ -s "drivers_x64/${filesystem}_x64.efi" ]] || { echo "Required EFI driver is missing: $filesystem" >&2; exit 1; }
done
echo "Running the native BOOT installation..."

export BOOT_INSTALL_SOURCE_DIR="$source_dir"
# The native build has completed. The following installer uses explicit status
# checks and its InstallationFailed flag. It receives the verified source
# directory and a fixed driver-selection argument in this same shell.
set +e +u
set +o pipefail

set -- --alldrivers
# The rEFInd package supplied Shim, signing and a non-interactive response.
# BOOT's self-contained native RUN must select these without prompting.
BootSecureBootEnabled=0
SecureBootVariable=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
LegacySecureBootVariable=/sys/firmware/efi/vars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c/data
if [[ -r "$SecureBootVariable" ]]; then
    BootSecureBootEnabled=$(od -An -tu1 -j4 -N1 "$SecureBootVariable" | tr -d '[:space:]')
elif [[ -r "$LegacySecureBootVariable" ]]; then
    BootSecureBootEnabled=$(od -An -tu1 -N1 "$LegacySecureBootVariable" | tr -d '[:space:]')
fi
if [[ "$BootSecureBootEnabled" == "1" ]]; then
    BootShim=""
    # Search standard mounted ESPs before distro package directories. Avoid
    # assuming an Ubuntu, Fedora, Mint, or particular disk layout.
    for search_root in /boot/efi/EFI /efi/EFI /boot/EFI /usr/lib/shim /usr/share/shim-signed; do
        [[ -d "$search_root" ]] || continue
        while IFS= read -r -d '' candidate; do
            if [[ -s "$candidate" ]]; then BootShim="$candidate"; break; fi
        done < <(find "$search_root" -maxdepth 3 -type f \
            \( -iname shimx64.efi -o -iname shimx64.efi.signed \) -print0 2>/dev/null)
        [[ -n "$BootShim" ]] && break
    done
    if [[ -z "$BootShim" ]]; then
        echo "BOOT: Secure Boot enabled but no installed Shim found; EFI unchanged." >&2
        exit 1
    fi
    if ! command -v mokutil >/dev/null 2>&1 || ! command -v sbsign >/dev/null 2>&1 ||
       ! command -v sbverify >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
        apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends \
            mokutil sbsigntool openssl || exit 1
    fi
    # Shim loads the one signed BOOTX64.EFI using its UEFI load options.
    # No alternative EFI destination or second BOOT executable is created.
    set -- --alldrivers --shim "$BootShim" --keepname --localkeys --yes
    echo "BOOT: Secure Boot detected; signing BOOTX64.EFI for installed Shim."
fi

RootDir="/"
TargetDir=/EFI/InfiltratorOS/BOOT
LocalKeysBase="boot_local"
ShimSource="none"
ShimType="none"
KeepName=0
TargetShim="default"
TargetX64="BOOTX64.EFI"
TargetIA32="BOOTIA32.EFI"
TargetAARCH64="BOOTAA64.EFI"
ExplicitDefault=0
LocalKeys=0
EncryptKeys=0
DeleteBootDir=0
AlwaysYes=0
EspGuid="C12A7328-F81F-11D2-BA4B-00A0C93EC93B"

# Historical parameter parser is used internally after the script sets
# --alldrivers. The public entry point rejects external arguments; do not
# interpret dormant parser options as supported user install destinations.
GetParams() {
   InstallToEspOnMac=1
   InstallDrivers="boot"
   while [[ $# -gt 0 ]]; do
      case "$1" in
         --notesp | --ownhfs | --usedefault | --root)
              echo "BOOT installs only under /EFI/InfiltratorOS/BOOT on the ESP; $1 is forbidden." >&2
              exit 1
              ;;
         --localkeys) LocalKeys=1 ;;
         --encryptkeys) EncryptKeys=1 ;;
         --shim | --preloader)
              [[ $# -ge 2 && -n "$2" ]] || { echo "$1 requires a file argument." >&2; exit 1; }
              ShimSource="$2"
              ShimType=$(basename "$ShimSource")
              shift
              ;;
         --keepname) KeepName=1 ;;
         --drivers | --alldrivers) InstallDrivers="all" ;;
         --nodrivers) InstallDrivers="none" ;;
         --yes) AlwaysYes=1 ;;
         *)
              echo "Usage: $0 [--nodrivers | --alldrivers] [--shim file] [--localkeys [--encryptkeys]] [--keepname] [--yes]" >&2
              echo "The only permitted destination is /EFI/InfiltratorOS/BOOT." >&2
              exit 1
              ;;
      esac
      shift
   done
   [[ "$TargetDir" == "/EFI/InfiltratorOS/BOOT" && "$RootDir" == "/" ]] || {
      echo "Refusing alternate installation directory or root." >&2
      exit 1
   }
   if [[ "$KeepName" == 1 && "$ShimSource" == "none" ]] ; then
      echo "--keepname requires --shim or --preloader." >&2
      exit 1
   fi
   if [[ "$EncryptKeys" == 1 && "$LocalKeys" == 0 ]] ; then
      echo "--encryptkeys requires --localkeys." >&2
      exit 1
   fi
   EtcKeysDir="$RootDir/etc/boot.d/keys"
}

# Read operator confirmation into global YesNo. The default is selected
# when input is empty. This prompt does not make a subsequent destructive
# file or NVRAM change atomic; that responsibility remains with the
# caller.
ReadYesNo() {
   if [[ $AlwaysYes == 1 ]] ; then
      YesNo="Y"
      echo "Y"
   else
      read -r YesNo
   fi
}

# Read the local signing key passphrase without terminal echo. This value
# is held in a shell variable for signing; it does not establish firmware
# trust or final key enrollment.
ReadKeyPassphrase() {
   if [[ $EncryptKeys == 1 ]]  && [ -z "$KeyPassphrase" ]; then
      while true; do
         echo -n "Private key passphrase (no echo): "
         read -r -s
         KeyPassphrase="$REPLY"
         REPLY="shred value"
         echo
         if [ "$1" == "--no-confirm" ]; then
            break
         else
            echo -n "Confirm passphrase (no echo): "
            read -r -s
            echo
            if [ "$KeyPassphrase" == "$REPLY" ]; then
               REPLY="shred value"
               break
            fi
         fi
      done
   fi
}

# Select EFI output architecture from the running host. This is part of
# the native install path, not proof that alternative architectures have
# qualified release builds. Tool availability and actual EFI image
# presence are checked separately.
DeterminePlatform() {
   local CpuType
   case "$OSTYPE" in
   darwin*)
      CpuType=$(ioreg -l -p IODeviceTree | grep firmware-abi | cut -d "\"" -f 4)
      case "$CpuType" in
      EFI64)
         Platform="x64"
         ;;
      EFI32)
         Platform="ia32"
         ;;
      *)
         echo "Unknown CPU type '$CpuType'; aborting!"
         exit 1
         ;;
      esac
      ;;
   linux*)
      CpuType=$(uname -m)
      case "$CpuType" in
      aarch64)
         Platform="aa64"
         ;;
      x86_64)
         Platform="x64"
         ;;
      i?86)
         Platform="ia32"

         if [[ -d /sys/firmware/efi ]] ; then
            if [[ "$ShimSource" != "none" && "$TargetDir" != "/BOOT/EFI" ]] ; then
               echo ""
               echo "CAUTION: shim does not currently supports 32-bit systems, so you should not"
               echo "use the --shim option to install on such systems. Aborting!"
               echo ""
               exit 1
            fi
            echo
            echo "CAUTION: This Linux installation uses a 32-bit kernel. 32-bit EFI-based"
            echo "computers are VERY RARE. If you've installed a 32-bit version of Linux"
            echo "on a 64-bit computer, you should manually install the 64-bit version of"
            echo "BOOT. If you're positive you want to continue with this installation,"
            echo "answer 'Y' to the following question..."
            echo
            echo -n "Are you sure you want to continue (Y/N)? "
            ReadYesNo
            if [[ $YesNo == "Y" || $YesNo == "y" ]] ; then
               echo "OK; continuing with the installation..."
            else
               exit 0
            fi
         fi
         ;;
      *)
         echo "Unknown CPU type '$CpuType'; aborting!"
         exit 1
         ;;
      esac
      ;;
   *)
      echo "Unknown OS; aborting!"
      exit 1
      ;;
   esac
}

# Determines the source executable, driver and resource paths used in this
# installation. Missing binary or configuration files must terminate rather
# than leave an apparently valid but incomplete firmware installation.
CheckForFiles() {

   if [[ -n "${BOOT_INSTALL_SOURCE_DIR:-}" ]] ; then

      ThisDir="$(cd -P "$BOOT_INSTALL_SOURCE_DIR" && pwd)" || exit 1
   else
      case "$OSTYPE" in
         darwin*)
              ThisDir="$( cd -P "${BASH_SOURCE%/*}" && pwd )"
              ;;
         linux*)
              ThisDir="$(dirname "$(readlink -f "$0")")"
              ;;
      esac
   fi
   BootDir="$ThisDir/boot"

   if [[ ! -f "$BootDir/boot_$Platform.efi" ]] ; then
      echo "The BOOT binary file is missing! Aborting installation!"
      exit 1
   fi

   if [[ -f "$BootDir/boot.conf-sample" ]] ; then
      ConfFile="$BootDir/boot.conf-sample"
   elif [[ -f "$ThisDir/boot.conf-sample" ]] ; then
      ConfFile="$ThisDir/boot.conf-sample"
   else
      echo "The sample configuration file is missing! Aborting installation!"
      exit 1
   fi

   if [[ -d "$BootDir/icons" ]] ; then
      IconsDir="$BootDir/icons"
   elif [[ -d "$ThisDir/icons" ]] ; then
      IconsDir="$ThisDir/icons"
   else
      echo "The icons directory is missing! Aborting installation!"
      exit 1
   fi
   if [[ -d "$BootDir/fonts" ]] ; then
      FontsDir="$BootDir/fonts"
   elif [[ -d "$ThisDir/fonts" ]] ; then
      FontsDir="$ThisDir/fonts"
   else
      echo "Required MB Corpo font directory is missing! Aborting installation!"
      exit 1
   fi
   [[ -s "$FontsDir/SHA256SUMS" ]] || { echo "MB/Daimler font manifest missing" >&2; exit 1; }
   font_count=$(find "$FontsDir" -maxdepth 1 -type f -name '*.ttf' | wc -l)
   [[ "$font_count" -eq 23 && $(wc -l < "$FontsDir/SHA256SUMS") -eq 23 ]] || {
      echo "Native BOOT installation requires all 23 MB/Daimler fonts" >&2; exit 1;
   }
   ( cd "$FontsDir" && sha256sum -c SHA256SUMS >/dev/null ) || {
      echo "Native BOOT font checksum verification failed" >&2; exit 1;
   }

   ThemesDir="$ThisDir/themes"

   echo "ShimSource is $ShimSource"
   if [[ "$ShimSource" != "none" ]] ; then
      if [[ -f "$ShimSource" ]] ; then
         if [[ $ShimType == "shimx64.efi" || $ShimType == "shim.efi" || $ShimType == "shimx64.efi.signed" ]] ; then
            if [[ "$KeepName" != "1" ]]; then
                TargetX64="grubx64.efi"
                TargetAARCH64="grubaa64.efi"
            fi
            MokManagerSource=$(dirname "$ShimSource")/mm$Platform.efi.signed
            if [[ ! -f "$MokManagerSource" ]] ; then
                MokManagerSource=$(dirname "$ShimSource")/mm$Platform.efi
            fi
            if [[ ! -f "$MokManagerSource" ]] ; then
                MokManagerSource=$(dirname "$ShimSource")/MokManager.efi
            fi
         elif [[ $ShimType == "preloader.efi" || $ShimType == "PreLoader.efi" ]] ; then
            TargetX64="loader.efi"
            MokManagerSource=$(dirname "$ShimSource")/HashTool.efi
         else
            echo "Unknown shim/PreBootloader filename: $ShimType!"
            echo "Known filenames are shimx64.efi, shim.efi, and PreLoader.efi. Aborting!"
            exit 1
         fi
      else
         echo "The specified shim/PreBootloader file, $ShimSource, doesn't exist!"
         echo "Aborting installation!"
         exit 1
      fi
   fi
}

# Copy the selected shim and MokManager executables into BOOT's
# installation directory, using inode comparisons to avoid recopying an
# identical source. The copy result affects Problems; copying a binary is
# not the same as verifying its Secure Boot signature or enrollment.
CopyShimFiles() {
   local TargetMMName
   local inode1
   local inode2

   inode1=$(ls -i "$ShimSource" 2> /dev/null | cut -f 1 -d " ")
   inode2=$(ls -i "$InstallDir/$TargetDir/$TargetShim" 2> /dev/null | cut -f 1 -d " ")
   if [[ "$inode1" != "$inode2" ]] ; then
      if ! cp -fb "$ShimSource" "$InstallDir/$TargetDir/$TargetShim" ; then
         Problems=1
      fi
   fi
   inode1=$(ls -i "$MokManagerSource" 2> /dev/null | cut -f 1 -d " ")
   TargetMMName=$(basename "$MokManagerSource")
   if [[ $TargetMMName == "mm$Platform.efi.signed" ]] ; then
       TargetMMName="mm$Platform.efi"
   fi
   inode2=$(ls -i "$InstallDir/$TargetDir/$TargetMMName" 2> /dev/null | cut -f 1 -d " ")
   if [[ "$inode1" != "$inode2" ]] ; then
      if [[ -f "$MokManagerSource" ]] ; then
         cp -fb "$MokManagerSource" "$InstallDir/$TargetDir/$TargetMMName"
      fi
      if [[ $? != 0 ]] ; then
         Problems=1
      fi
   fi
}

# Stage public certificate representations for local-key installations.
# Private key material belongs in the host key directory and is not copied
# to the ESP by this helper. Presence of a certificate file is not
# evidence of firmware trust.
CopyKeys() {
   if [[ $LocalKeys == 1 ]] ; then
      mkdir -p "$InstallDir/$TargetDir/keys/"
      cp "$EtcKeysDir/$LocalKeysBase.cer" "$InstallDir/$TargetDir/keys/"
      cp "$EtcKeysDir/$LocalKeysBase.crt" "$InstallDir/$TargetDir/keys/"
   fi
}

# Inspect the destination for an earlier configuration and set Upgrade for
# the macOS installation path. The Linux path independently clears its
# BOOT directory before CopyBootFiles, so this message must not be used as
# a promise that Linux reinstall preserves boot.conf.
DetermineTargetDir() {
   Upgrade=0
   if [[ "$TargetDir" == "/EFI/InfiltratorOS/BOOT" ]] ; then
      if [[ -f "$InstallDir/$TargetDir/boot.conf" ]] ; then
         Upgrade=1
         echo "Found BOOT configuration in $InstallDir/$TargetDir; preserving it."
      fi
   fi
}

# Records the boot-volume filesystem identity used when selecting drivers;
# filesystem detection is not itself proof of usable driver support.
SetBootFS() {
   BootFS=""
   case "$OSTYPE" in
      linux*)
           if command -v blkid &>/dev/null; then
              BootPart=$(df "$RootDir"/boot | grep dev | cut -f 1 -d " ")
              BootFS=$(blkid -o export "$BootPart" 2> /dev/null | grep TYPE= | cut -f 2 -d =)

              if [[ -z "$BootFS" ]] ; then
                 BootFS=$(blkid "$BootPart" 2> /dev/null | grep -Po 'TYPE=\"\K[^\"]*')
              fi
           fi
           ;;
      darwin*)

           Temp=$(diskutil list | grep -i '0FC63DAF-8483-4772-8E79-3D69D8477DE4\|BC13C2FF-59E6-4262-A352-B275FD6F7172\|933AC7E1-2EB4-4F13-B844-0E14E2AEF915\|E6D6D379-F507-44C2-A23C-238F2A3DF928\|A19D880F-05FC-4D3B-A006-743F0F84911E\|0657FD6D-A4AB-43C4-84E5-0933C84B4F4F\|Linux')
           BootFS=""
           if [[ -n $Temp ]] ; then
              echo "Found suspected Linux partition(s); installing ext4fs driver."
              BootFS="ext4"
           fi
           ;;
   esac
}

# Install firmware EFI filesystem drivers selected from the current build
# and detected filesystem policy. These are PE/COFF firmware drivers, not
# Common V2 hosted .so files. An installed driver is only a candidate for
# Driver Binding and does not prove that firmware can mount a
# representative volume.
CopyDrivers() {
   if [[ $InstallDrivers == "all" ]] ; then
      mkdir -p "$InstallDir/$TargetDir/drivers_$1"
      cp "$ThisDir"/drivers_"$1"/*_"$1".efi "$InstallDir/$TargetDir/drivers_$1/" 2> /dev/null
      cp "$BootDir"/drivers_"$1"/*_"$1".efi "$InstallDir/$TargetDir/drivers_$1/" 2> /dev/null
   elif [[ "$InstallDrivers" == "boot" ]] ; then
      SetBootFS
      DriverType=""
      case $BootFS in
         ext2 | ext3) DriverType="ext2"

              ;;
         ext4) DriverType="ext4"
              ;;
         reiserfs) DriverType="reiserfs"
              ;;
         btrfs) DriverType="btrfs"
              ;;
         hfsplus) DriverType="hfs"
              ;;
         ntfs) DriverType="ntfs"
              ;;
         *) BootFS=""
      esac
      if [[ -n $BootFS ]] ; then
         echo "Installing driver for $BootFS (${DriverType}_$1.efi)"
         mkdir -p "$InstallDir/$TargetDir/drivers_$1"
         cp "$ThisDir/drivers_$1/${DriverType}_$1.efi" "$InstallDir/$TargetDir/drivers_$1/" 2> /dev/null
         cp "$BootDir/drivers_$1/${DriverType}_$1.efi" "$InstallDir/$TargetDir/drivers_$1"/ 2> /dev/null
      fi
   fi
}

# Copy optional EFI utilities without interpreting their presence as a
# successful firmware execution or operating-system discovery result.
CopyTools() {
   if [[ $OSTYPE == darwin* && -f "$BootDir/tools_$1/gptsync_$1.efi" ]] ; then
      cp -f "$BootDir/tools_$1/gptsync_$1.efi" "$InstallDir/$TargetDir/" || {
         echo "Unable to install optional BOOT tool." >&2
         Problems=1
      }
   fi
}

# BOOT has one fixed directory. Reject alternate targets and symbolic links
# while allowing unconditional replacement of the directory's contents.
CheckBootDestination() {
   if [[ "$TargetDir" != "/EFI/InfiltratorOS/BOOT" || "$RootDir" != "/" ||
         -z "$InstallDir" || ! -d "$InstallDir" ]]; then
      echo "BOOT can install only to /EFI/InfiltratorOS/BOOT on a mounted ESP." >&2
      return 1
   fi
   if [[ -L "$InstallDir/EFI" || -L "$InstallDir/EFI/InfiltratorOS" ||
         -L "$InstallDir/$TargetDir" || -L "$InstallDir/$TargetDir/$TargetX64" ]]; then
      echo "Refusing BOOT installation through an EFI symbolic link." >&2
      return 1
   fi
}

# Installs the EFI executable, drivers, graphics, keys and boot.conf under
# BOOT's selected directory. This copies resources; it does not establish
# that a detected OS or compressed loader will later boot successfully.
CopyBootFiles() {
   CheckBootDestination || exit 1
   mkdir -p "$InstallDir/$TargetDir"
   if [[ $Platform == 'x64' ]] ; then
      if ! cp "$BootDir/boot_x64.efi" "$InstallDir/$TargetDir/$TargetX64" ; then
         Problems=1
      fi
      CopyDrivers x64
      CopyTools x64
      Boot="$TargetX64"
      CopyKeys
      if [[ "$ShimSource" != "none" ]] ; then
         if [[ "$TargetShim" == "default" ]] ; then
            TargetShim=$(basename "$ShimSource")
         fi
         CopyShimFiles
         Boot="$TargetShim"
         if [[ $LocalKeys == 0 ]] ; then
            echo "Storing copies of BOOT Secure Boot public keys in $EtcKeysDir"
            mkdir -p "$EtcKeysDir"
            cp "$ThisDir/keys/boot.cer" "$EtcKeysDir" 2> /dev/null
            cp "$ThisDir/keys/boot.crt" "$EtcKeysDir" 2> /dev/null
         fi
      fi
   elif [[ $Platform == 'ia32' || $Platform == 'aa64' ]] ; then
      if [[ $Platform == 'ia32' ]] ; then
         if ! cp "$BootDir/boot_ia32.efi" "$InstallDir/$TargetDir/$TargetIA32" ; then
            Problems=1
         fi
      else
         if ! cp "$BootDir/boot_aa64.efi" "$InstallDir/$TargetDir/$TargetAARCH64" ; then
            Problems=1
         fi
      fi
      CopyDrivers $Platform
      CopyTools $Platform
      Boot="$TargetIA32"
      if [[ "$Platform" == "aa64" ]] ; then Boot="$TargetAARCH64"; fi
   else
      echo "Unknown platform! Aborting!"
      exit 1
   fi
   echo "Copied BOOT binary files"
   echo ""
   if [[ -d "$InstallDir/$TargetDir/icons" ]] ; then
      rm -rf "$InstallDir/$TargetDir/icons-backup" &> /dev/null
      mv -f "$InstallDir/$TargetDir/icons" "$InstallDir/$TargetDir/icons-backup"
      echo "Notice: Backed up existing icons directory as icons-backup."
   fi
   if ! cp -r "$IconsDir" "$InstallDir/$TargetDir" ; then
      Problems=1
   fi
   # Replace the obsolete bitmap atlas directory with the three native
   # Verified 23-face TrueType collection for BOOT's native UEFI rasteriser.
   rm -rf -- "$InstallDir/$TargetDir/fonts"
   if ! cp -r "$FontsDir" "$InstallDir/$TargetDir" ; then
      Problems=1
   fi
   rm -rf -- "$InstallDir/$TargetDir/themes"
   if [[ -d "$ThemesDir" ]]; then
      if ! cp -r "$ThemesDir" "$InstallDir/$TargetDir"; then
         Problems=1
      fi
   fi
   mkdir -p "$InstallDir/$TargetDir/keys"
   cp -rf "$ThisDir"/keys/*.[cd]er "$InstallDir/$TargetDir/keys/" 2> /dev/null
   cp -rf "$EtcKeysDir"/*.[cd]er "$InstallDir/$TargetDir/keys/" 2> /dev/null
   if [[ -f "$InstallDir/$TargetDir/boot.conf" ]] ; then
      echo "Existing boot.conf file found; copying sample file as boot.conf-sample"
      echo "to avoid overwriting your customizations."
      echo ""
      if ! cp -f "$ConfFile" "$InstallDir/$TargetDir" ; then
         Problems=1
      fi
   else
      echo "Copying sample configuration file as boot.conf; edit this file to configure"
      echo "BOOT."
      echo ""
      if ! cp -f "$ConfFile" "$InstallDir/$TargetDir/boot.conf" ; then
         Problems=1
      fi
   fi
   if [[ $DeleteBootDir == 1 ]] ; then
      echo "Deleting the temporary directory $BootDir"
      rm -r "$BootDir"
   fi
}

# Write the firmware fallback CSV registration hint as UCS-2 text for a
# supported platform. This file is separate from Boot#### NVRAM
# registration and from the actual BOOTX64.EFI image; a correctly encoded
# CSV does not guarantee a firmware will consume it.
CreateBootCsvFile() {
   IConv="$(command -v iconv 2> /dev/null)"
   if [[ -x "$IConv" ]] ; then
      if [[ "$Platform" == "x64" && -d "$InstallDir/$TargetDir" ]] ; then
         echo "$Boot,BOOT Boot Manager,,This is the boot entry for BOOT" | \
              $IConv -t UCS-2 > "$InstallDir/$TargetDir/BOOT.CSV"
      fi
      if [[ "$Platform" == "ia32" && -d "$InstallDir/$TargetDir" ]] ; then
         echo "$TargetIA32,BOOT Boot Manager,,This is the boot entry for BOOT" | \
              $IConv -t UCS-2 > "$InstallDir/$TargetDir/BOOT.CSV"
      fi
      if [[ "$Platform" == "aarch64" && -d "$InstallDir/$TargetDir" ]] ; then
         echo "$TargetAARCH64,BOOT Boot Manager,,This is the boot entry for BOOT" | \
              $IConv -t UCS-2 > "$InstallDir/$TargetDir/BOOT.CSV"
      fi
   fi
}

# Find and, where required, mount a macOS EFI System Partition using
# diskutil and mount output. Later copying and bless operations depend on
# the resolved InstallDir. The path is host-dependent and the final fixed
# BOOT subdirectory check remains mandatory.
MountOSXESP() {

   Temp=$(mount | sed -n -E "/^(\/dev\/disk.*) on \/ \(.*$/s//\1/p")
   if [ "$Temp" ]; then
      Temp=$(diskutil list | grep " EFI " | grep -o 'disk.*' | head -n 1)
      if [ -z "$Temp" ]; then
         echo "Warning: root device doesn't have an EFI System Partition"
      fi
   else
      echo "Warning: root device could not be found"
   fi
   if [ -z "$Temp" ]; then
      Temp=$(diskutil list | sed -n -E '/^ *[0-9]+:[ ]+EFI EFI[ ]+[0-9.]+ [A-Z]+[ ]+(disk[0-9]+s[0-9]+)$/ { s//\1/p
             q
         }' )

      if [ -z "$Temp" ]; then
         echo "Could not find an EFI System Partition. Aborting!"
         exit 1
      fi
   fi
   Esp=/dev/"$Temp"

   Temp=$(df -P | grep "$Esp ")
   InstallDir=$(echo "$Temp" | cut -f 6- -d ' ' | sed 's/\/\+/\//g')
   if [[ "$InstallDir" == '' ]] ; then
      mkdir /Volumes/ESP &> /dev/null

      if ! mount -t msdos "$Esp" /Volumes/ESP ; then
         OwnHfs=1
         InstallToEspOnMac=0
         if ! mount -t hfs "$Esp" /Volumes/Esp ; then
            printf "Unable to mount ESP! Aborting!\n\n"
            exit 1
         fi
      fi
      UnmountEsp=1
      InstallDir="/Volumes/ESP"
   fi
}

# Query macOS System Integrity Protection before the host-side bless step.
# csrutil text is a platform indication, not proof that BOOT later starts.
CheckForSIP() {
   local OKToInstall
   local RootName

   if [[ -x "/usr/bin/csrutil" && -z "$TargetPart" ]] ; then
      OKToInstall=$(/usr/bin/csrutil status | \
                         grep "Protection status: disabled\|enabled (Apple Internal)\|NVRAM Protections: disabled")
      if [[ -z "$OKToInstall" ]] ; then
         echo
         echo "**** ALERT: SIP ENABLED! ****"
         echo
         if [[ "$Upgrade" == "1" ]] ; then
            echo "You are attempting to upgrade an existing installation, but it appears that"
            echo "System Integrity Protection (SIP) is enabled. If BOOT is working now, then"
            echo "this is fine; you can upgrade your existing BOOT. If BOOT is not working,"
            echo "though, re-installing from this boot will not help. To re-enable BOOT, you"
            echo "must re-install it from a Recovery system or from another OS. To enter the"
            echo "Recovery system and re-install BOOT:"
         else
            echo "BOOT cannot be installed because System Integrity Protection (SIP) seems"
            echo "to be enabled! You must install BOOT from your Recovery installation or"
            echo "from another OS. To install from the Recovery system:"
         fi
         echo
         echo "  1. Reboot"
         echo "  2. Hold down Command+R as the chime sounds"
         echo "  3. When the OS has booted, select Utilities->Terminal"
         echo "  4. Change to this directory with the 'cd' command; it will probably be under"
         if [[ "$(pwd | cut -b 1-8)" == "/Volumes" ]] ; then
            echo "     $(pwd)"
         else
            RootName=$(diskutil info -plist / | grep -A 1 VolumeName | grep string | cut -d \> -f 2 | cut -d \< -f 1)
            echo "     /Volumes/$RootName$(pwd)"
         fi
         echo "  5. Re-run this script."
         echo
         if [[ "$Upgrade" != "1" ]] ; then
            echo "If you believe SIP is NOT enabled, you may attempt an installation anyhow,"
            echo "but it may fail."
            echo
         fi
         echo "For more on this subject, see http://www.rodsbooks.com/boot/sip.html"
         echo
         echo -n "Do you want to attempt installation (Y/N)? "
         ReadYesNo
         if [[ $YesNo == "N" || $YesNo == "n" ]] ; then
            echo "Exiting!"
            exit
         fi
      fi
   fi
}

# Perform the macOS host's BOOT file installation and firmware bless
# operation at the fixed target directory. Bless and firmware-variable
# changes are externally visible side effects; a copied loader is not
# proof that subsequent startup succeeds.
InstallOnOSX() {
   echo "Installing BOOT on macOS...."
   [[ "$TargetDir" == "/EFI/InfiltratorOS/BOOT" ]] || {
      echo "Refusing installation outside /EFI/InfiltratorOS/BOOT." >&2
      return 1
   }
   MountOSXESP
   echo "Installing BOOT to the partition mounted at $InstallDir"
   DetermineTargetDir
   CheckForSIP
   CopyBootFiles
   mkdir -p /usr/local/bin &> /dev/null
   cp "$ThisDir/mountesp" /usr/local/bin/ &> /dev/null
   bless --mount "$InstallDir" --setBoot --file "$InstallDir/$TargetDir/$Boot" --shortform
   if [[ $? != 0 ]] ; then
      Problems=1
   fi
}

# Queries Secure Boot firmware state and interactive signing/shim choices.
# Observed state and user prompts cannot substitute for firmware validation.
CheckSecureBoot() {
   IsSecureBoot="0"
   if [[ -f /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c ]] ; then
      IsSecureBoot=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | awk '{print substr($0,length,1)}')
   elif [[ -f /sys/firmware/efi/vars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c/data ]] ; then
      IsSecureBoot=$(od -An -t u1 /sys/firmware/efi/vars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c/data | tr -d '[:space:]')
   fi
   if [[ $IsSecureBoot == "1" && "$ShimSource" == "none" ]] ; then
      echo ""
      echo "CAUTION: Your computer appears to be booted with Secure Boot, but you haven't"
      echo "specified a valid shim.efi file source. Chances are you should re-run with"
      echo "the --shim option. You can read more about this topic at"
      echo "http://www.rodsbooks.com/boot/secureboot.html."
      echo ""
      echo -n "Do you want to proceed with installation (Y/N)? "
      ReadYesNo
      if [[ $YesNo == "Y" || $YesNo == "y" ]] ; then
         echo "OK; continuing with the installation..."
      else
         exit 0
      fi
   fi

   if [[ "$ShimSource" != "none" && ! $IsSecureBoot == "1" ]] ; then
      echo ""
      echo "You've specified installing using a shim.efi file, but your computer does not"
      echo "appear to be running in Secure Boot mode. Although installing in this way"
      echo "should work, it's unnecessarily complex. You may continue, but unless you"
      echo "plan to enable Secure Boot, you should consider stopping and omitting the"
      echo "--shim option. You can read more about this topic at"
      echo "http://www.rodsbooks.com/boot/secureboot.html."
      echo ""
      echo -n "Do you want to proceed with installation (Y/N)? "
      ReadYesNo
      if [[ $YesNo == "Y" || $YesNo == "y" ]] ; then
         echo "OK; continuing with the installation..."
      else
         exit 0
      fi
   fi

   if [[ $LocalKeys != 0 && ! $IsSecureBoot == "1" ]] ; then
      echo ""
      echo "You've specified re-signing your BOOT binaries with locally-generated keys,"
      echo "but your computer does not appear to be running in Secure Boot mode. The"
      echo "keys you generate will be useless unless you enable Secure Boot. You may"
      echo "proceed with this installation, but before you do so, you may want to read"
      echo "more about it at http://www.rodsbooks.com/boot/secureboot.html."
      echo ""
      echo -n "Do you want to proceed with installation (Y/N)? "
      ReadYesNo
      if [[ $YesNo == "Y" || $YesNo == "y" ]] ; then
         echo "OK; continuing with the installation..."
      else
         exit 0
      fi
   fi

}

# Create or reuse local signing material. New private keys and public
# certificate encodings are written under the host key directory;
# incomplete pre-existing sets are backed up before regeneration. File
# permissions limit local access but do not establish enrollment in
# firmware or MOK databases.
GenerateKeys() {
   PrivateKey="$EtcKeysDir/$LocalKeysBase.key"
   CertKey="$EtcKeysDir/$LocalKeysBase.crt"
   DerKey="$EtcKeysDir/$LocalKeysBase.cer"
   OpenSSL="$(command -v openssl 2> /dev/null)"

   if [[ ! -f "$PrivateKey" || ! -f "$CertKey" || ! -f "$DerKey" ]] ; then
      echo "Generating a fresh set of local keys...."
      mkdir -p "$EtcKeysDir"
      chmod 0700 "$EtcKeysDir"
      if [[ ! -x "$OpenSSL" ]] ; then
         echo "Can't find openssl, which is required to create your private signing keys!"
         echo "Aborting!"
         exit 1
      fi
      if [[ -f "$PrivateKey" ]] ; then
         echo "Backing up existing $PrivateKey"
         mv -f "$PrivateKey" "$PrivateKey.backup" 2> /dev/null
      fi
      if [[ -f "$CertKey" ]] ; then
         echo "Backing up existing $CertKey"
         mv -f "$CertKey" "$CertKey.backup" 2> /dev/null
      fi
      if [[ -f "$DerKey" ]] ; then
         echo "Backing up existing $DerKey"
         mv -f "$DerKey" "$DerKey.backup" 2> /dev/null
      fi
      if [[ $EncryptKeys == 1 ]]; then
         KeyEncryptionArgument=""
      else
         KeyEncryptionArgument="-nodes"
      fi
      "$OpenSSL" req -new -x509 -newkey rsa:2048 -keyout "$PrivateKey" -out "$CertKey" \
                     $KeyEncryptionArgument -days 3650 -subj "/CN=Locally-generated BOOT key/"
      "$OpenSSL" x509 -in "$CertKey" -out "$DerKey" -outform DER
      chmod 0600 "$PrivateKey"
   else
      echo "Using existing local keys...."
   fi
}

# Sign one PE/COFF file with the chosen private key/certificate pair using
# sbsign. Encrypted keys use an interactive passphrase path; exit status
# from the signing command, not filtered warning text, determines failure.
# A produced signature still requires a compatible enrolled trust chain at
# boot.
SignOneBinary() {
   ReadKeyPassphrase --no-confirm
   if [[ "$EncryptKeys" == 1 ]] ; then
      SbSignCommand=$(printf "%q " "$SBSign" --key "$PrivateKey" --cert "$CertKey" --output "$2" "$1")
      echo "$KeyPassphrase" |
         script -qefc "$SbSignCommand" --force /dev/null 2>&1 | ( \
              head -n 2 >/dev/null
              grep -v "data remaining.*gaps between PE/COFF sections"
            )
       local status="${PIPESTATUS[1]}"
   else
      "$SBSign" --key "$PrivateKey" --cert "$CertKey" --output "$2" "$1" 2>&1 >/dev/null | \
                grep -v "data remaining.*gaps between PE/COFF sections"
      local status="${PIPESTATUS[0]}"
   fi
   if [[ "$status" != 0 ]] ; then
      echo "Problem signing the binary $1! Aborting!"
      exit 1
   fi
}

# Coordinate local signing of BOOT binaries after selecting a signing tool
# and key material. The action changes executable bytes and therefore
# requires a matching boot-time trust configuration. It is distinct from
# firmware verification of signed EFI executables.
ReSignBinaries() {
   SBSign="$(command -v sbsign 2> /dev/null)"
   echo "Found sbsign at $SBSign"
   TempDir="/tmp/boot_local"
   if [[ ! -x "$SBSign" ]] ; then
      echo "Can't find sbsign, which is required to sign BOOT with your own keys!"
      echo "Aborting!"
      exit 1
   fi
   GenerateKeys
   mkdir -p "$TempDir/drivers_$Platform"
   cp "$BootDir"/boot.conf-sample "$TempDir" 2> /dev/null
   cp "$ThisDir"/boot.conf-sample "$TempDir" 2> /dev/null
   cp "$BootDir"/boot_ia32.efi "$TempDir" 2> /dev/null
   cp -a "$BootDir"/drivers_ia32 "$TempDir" 2> /dev/null
   cp -a "$ThisDir"/drivers_ia32 "$TempDir" 2> /dev/null
   SignOneBinary "$BootDir/boot_$Platform.efi" "$TempDir/boot_$Platform.efi"
   SaveIFS=$IFS
   IFS=$(echo -en "\n\b")
   for Driver in "$BootDir"/drivers_"$Platform"/*.efi "$ThisDir"/drivers_"$Platform"/*.efi ; do
      [[ -e "$Driver" ]] || continue
      TempName=$(basename "$Driver")
      SignOneBinary "$Driver" "$TempDir/drivers_$Platform/$TempName"
   done
   IFS=$SaveIFS
   BootDir="$TempDir"
   DeleteBootDir=1
}

# Determines an EFI System Partition from native block/mount information.
# Choosing the wrong partition is a critical side effect because later
# operations write the resolved path and EFI firmware variables.
FindLinuxESP() {
   local Dmraid
   local DmStatus
   local FatPart
   local IsItRaid
   local ParentDisk
   local PartNum
   local PotentialParent
   local Sgdisk
   local TypeCode

   echo "The ESP doesn't seem to be mounted! Trying to find it...."
   Dmraid="$(command -v dmraid 2> /dev/null)"
   Sgdisk="$(command -v sgdisk 2> /dev/null)"
   if [[ ! -x "$Sgdisk" ]] ; then
      echo "The sgdisk program (part of the gdisk package) is not installed; please"
      echo "install it and try again."
      exit 1
   fi

   for FatPart in $(blkid -t TYPE="vfat" -o device) ; do

      for PotentialParent in $(lsblk | grep disk | cut -f 1 -d " ") ; do
         IsItRaid=0

         if [[ -x "$Dmraid" ]] ; then
            DmStatus=$(dmraid -r | grep "$PotentialParent")
            if [ -n "$DmStatus" ] ; then
               echo "/dev/$PotentialParent seems to be part of a RAID array; skipping!"
               IsItRaid=1
            fi
         fi

         if [[ $FatPart == *"/dev/$PotentialParent"* && $IsItRaid == 0 ]] ; then
            ParentDisk=$PotentialParent
            break
         fi
      done
      if [[ $IsItRaid == 0 ]] ; then
         PartNum=$(grep -Eo '[0-9]{1,4}' <<< "$FatPart" | tail -n 1)
         TypeCode=$($Sgdisk -i "$PartNum" /dev/"$ParentDisk" | grep "GUID code")
         shopt -s nocasematch
         if [[ $TypeCode == *$EspGuid* ]] ; then
             InstallDir="$RootDir/boot/efi"
             InstallDir=$(echo "$InstallDir" | sed 's/\/\+/\//g')
             echo "Mounting ESP ($FatPart) at $InstallDir"
             mkdir -p "$InstallDir"
             mount "$FatPart" "$InstallDir"
             EspFilesystem="vfat"
             shopt -u nocasematch
             break
         fi
         shopt -u nocasematch
      fi
   done
}

# Resolve a mounted EFI System Partition using host mount information.
# Existence of a mount path alone cannot establish the intended device,
# partition identity or subsequent firmware registration.
FindMountedESP() {
   mount /boot &> /dev/null
   mount /boot/efi &> /dev/null
   mount /efi &> /dev/null
   EspLine=$(df "$RootDir/efi" 2> /dev/null | grep efi)
   if [[ -z "$EspLine" ]] ; then
      EspLine=$(df "$RootDir"/boot/efi 2> /dev/null | grep boot/efi)
   fi
   if [[ -z "$EspLine" ]] ; then
      EspLine=$(df "$RootDir"/boot 2> /dev/null | grep boot)
   fi
   InstallDir=$(echo "$EspLine" | xargs | cut -d " " -f 6 | sed 's/\/\+/\//g')

   if [[ -n "$InstallDir" ]] ; then
      EspFilesystem=$(grep -w "$InstallDir" /etc/mtab | uniq | grep -v autofs | cut -d " " -f 3 | uniq)
   fi
   if [[ $EspFilesystem != 'vfat' ]] ; then
      FindLinuxESP
   fi
   if [[ $EspFilesystem != 'vfat' ]] ; then
      echo "$RootDir/$InstallDir doesn't seem to be on a VFAT filesystem. The ESP must be"
      echo "mounted at $RootDir/boot, $RootDir/efi, or $RootDir/boot/efi, and it must be"
      echo "VFAT (not msdos)! Aborting!"
      if [[ -d /sys/firmware/efi ]] ; then
         exit 1
      else
         echo "The computer appears to be running in BIOS mode and has no ESP. You should"
         echo "create an ESP, and ideally boot in EFI mode, before installing BOOT."
         exit 1
      fi
   fi
   echo "ESP was found at $InstallDir using $EspFilesystem"
}

# Creates or reorders a firmware Boot#### entry for BOOT. The operation
# must preserve independent Windows, GRUB and fallback boot paths and reject
# ambiguous or duplicate BOOT records without creating another entry.
AddBootEntry() {
   local InstallPart InstallDisk="" PartNum="" Name InstallPartGuid
   local EntryFilename EfiEntryFilename ExistingEntry BootNum BootOrder NewOrder Candidate
   local RealBootBinary Efibootmgr
   local -a OrderEntries=()
   Efibootmgr="$(command -v efibootmgr 2> /dev/null)"
   if [[ -z "$Efibootmgr" ]] ; then
      echo "Cannot set BOOT as default: efibootmgr is unavailable." >&2
      Problems=1
      return 1
   fi
   InstallPart=$(grep "$InstallDir " /etc/mtab | grep -v autofs | cut -d " " -f 1 | tail -n1)
   for Name in $(lsblk -r | grep disk | cut -f 1 -d " ") ; do
      if [[ $InstallPart == *"$Name"* ]] ; then
         InstallDisk="/dev/$Name"
         PartNum=${InstallPart#"$InstallDisk"}
         PartNum="${PartNum//[!0-9]/}"
         break
      fi
   done
   if [[ -z "$InstallDisk" || -z "$PartNum" ]] ; then
      echo "Cannot identify BOOT EFI partition." >&2
      Problems=1
      return 1
   fi
   InstallPartGuid=$(blkid -s PARTUUID -o value "$InstallPart")
   if [[ -z "$InstallPartGuid" ]] ; then
      echo "Cannot identify BOOT EFI partition GUID." >&2
      Problems=1
      return 1
   fi
   EntryFilename="$TargetDir/$Boot"
   EfiEntryFilename="${EntryFilename//\//\\}"
   local FirmwareEntries CurrentEntry LowerEntry CandidateNum
   local MatchCount BootEntryCount Registered=0

   while : ; do
      if ! FirmwareEntries=$("$Efibootmgr" -v) ; then
         echo "Cannot inspect firmware entries; refusing to create another BOOT entry." >&2
         Problems=1
         return 1
      fi
      if [[ "$FirmwareEntries" != *"BootOrder:"* ]] ; then
         echo "Incomplete firmware entry listing; refusing to create another BOOT entry." >&2
         Problems=1
         return 1
      fi
      BootNum=""
      MatchCount=0
      BootEntryCount=0
      while IFS= read -r CurrentEntry ; do
         if [[ "$CurrentEntry" =~ ^Boot([[:xdigit:]]{4})\*?[[:space:]] ]] ; then
            CandidateNum="${BASH_REMATCH[1]^^}"
            LowerEntry="${CurrentEntry,,}"
            if [[ "$LowerEntry" == *"file(${EfiEntryFilename,,})"* || "$LowerEntry" == *"boot boot manager"* ]] ; then
               BootEntryCount=$((BootEntryCount + 1))
               if [[ "$LowerEntry" == *"file(${EfiEntryFilename,,})"* && "$LowerEntry" == *"${InstallPartGuid,,}"* ]] ; then
                  MatchCount=$((MatchCount + 1))
                  BootNum="$CandidateNum"
               fi
            fi
         fi
      done <<< "$FirmwareEntries"
      if [[ "$MatchCount" == 1 && "$BootEntryCount" == 1 ]] ; then
         break
      fi
      if [[ "$BootEntryCount" != 0 ]] ; then
         echo "BOOT firmware entry is duplicated or ambiguous; refusing to add another." >&2
         Problems=1
         return 1
      fi
      if [[ "$Registered" == 1 ]] ; then
         echo "New BOOT firmware entry could not be verified; refusing another registration." >&2
         Problems=1
         return 1
      fi

      Registered=1

      # One shim-backed firmware entry; never register a second unsigned
      # "direct" BOOT entry and then fail the duplicate-entry check.
      if [[ "$KeepName" == 0 ]] ; then
         "$Efibootmgr" -c -l "$EfiEntryFilename" -L "BOOT Boot Manager" -d "$InstallDisk" -p "$PartNum" || {
            Problems=1
            return 1
         }
      else
         "$Efibootmgr" -c -l "$EfiEntryFilename" -L "BOOT Boot Manager" -d "$InstallDisk" -p "$PartNum" -u "$TargetShim $TargetX64" || {
            Problems=1
            return 1
         }
      fi
   done

   BootNum="${BootNum^^}"
   if ! "$Efibootmgr" -b "$BootNum" -a ; then
      echo "Could not activate BOOT UEFI entry." >&2
      Problems=1
      return 1
   fi
   BootOrder=$("$Efibootmgr" | sed -n 's/^BootOrder:[[:space:]]*//p' | head -n1)
   if [[ -z "$BootOrder" ]] ; then
      echo "Cannot read UEFI BootOrder." >&2
      Problems=1
      return 1
   fi
   NewOrder="$BootNum"
   IFS=, read -r -a OrderEntries <<< "$BootOrder"
   for Candidate in "${OrderEntries[@]}" ; do
      if [[ ! "$Candidate" =~ ^[[:xdigit:]]{4}$ ]] ; then
         echo "Unexpected UEFI BootOrder: $BootOrder" >&2
         Problems=1
         return 1
      fi
      if [[ "${Candidate^^}" != "$BootNum" ]] ; then
         NewOrder+=",$Candidate"
      fi
   done
   if ! "$Efibootmgr" -o "$NewOrder" ; then
      echo "Could not set BOOT first in UEFI BootOrder." >&2
      Problems=1
      return 1
   fi
   BootOrder=$("$Efibootmgr" | sed -n 's/^BootOrder:[[:space:]]*//p' | head -n1)
   if [[ "${BootOrder%%,*}" != "$BootNum" ]] ; then
      echo "Firmware did not retain BOOT as the default." >&2
      Problems=1
      return 1
   fi
   echo "BOOT (Boot${BootNum}) explicitly set first in UEFI BootOrder."
}

# Inspect or request enrollment of the selected public key through mokutil
# when a shim-managed path is present. An enrollment request can require
# confirmation on a later reboot; script completion must not be
# interpreted as final firmware acceptance. The --test-key success and
# failure branches should be verified against the installed mokutil
# semantics.
InstallSBKey() {
    local UsedDerKey
    if [ "$LocalKeys" == "1" ] ; then
        UsedDerKey="$DerKey"
    else
        UsedDerKey="$ThisDir/keys/boot.cer"
    fi
    if command -v mokutil &>/dev/null ; then
       if mokutil --test-key "$UsedDerKey" &> /dev/null ; then
            echo "BOOT requires a Secure Boot key to be used with Secure Boot active. This"
            echo "script can install the key as a Machine Owner Key (MOK) for use with Shim."
            echo "If you've taken full control of Secure Boot on your computer and are NOT"
            echo "using Shim, you will instead need to add the key with efi-updatevar in"
            echo "Linux, KeyTool in the UEFI, or the firmware's built-in key maintenance"
            echo "tools."
            echo ""
            echo -n "Do you want to add the key as a MOK for use with Shim? (Y/N) "
            ReadYesNo
            echo ""
            if [[ "$YesNo" == "Y" || "$YesNo" == "y" ]] ; then
                echo "You will now be asked to enter a password twice. When you reboot, a blue"
                echo "screen should appear asking if you want to press a key to manage MOKs. Do"
                echo "so, and then select the option to 'Enroll MOK'. After you confirm the"
                echo "enrollment, you will be asked to enter the password you're about to type."
                if ! mokutil -i "$UsedDerKey" ; then
                    echo "Problem detected installing MOK!"
                    Problems=1
                fi
            fi
            echo "For more on BOOT and Secure Boot, see:"
            echo "https://www.rodsbooks.com/boot/secureboot.html"
        else
            echo "The appropriate Secure Boot key is already enrolled."
        fi
    fi
}

# Performs the Linux-host ESP/NVRAM mutation. It explicitly clears the prior
# /EFI/InfiltratorOS/BOOT directory before CopyBootFiles, including any old
# boot.conf and icons; no files in other vendor EFI paths are intended to be
# deleted. The fixed-path and symlink checks run before this removal.
InstallOnLinux() {
   if [[ "$TargetDir" != "/EFI/InfiltratorOS/BOOT" ]] ; then
      echo "Refusing installation outside /EFI/InfiltratorOS/BOOT." >&2
      return 1
   fi
   echo "Installing BOOT from a Linux host into /EFI/InfiltratorOS/BOOT..."
   modprobe efivars &> /dev/null
   FindMountedESP
   CheckBootDestination || return 1

   if [[ $LocalKeys == 1 ]] ; then
      ReSignBinaries
   fi

   CheckSecureBoot

   # Do not modify the ESP or BootOrder until the local signing key is
   # enrolled. MOK enrollment requires a firmware-screen action that a
   # detached background installer cannot perform.
   if [[ "$IsSecureBoot" == "1" ]]; then
      if [[ "$ShimSource" == "none" || "$LocalKeys" != "1" || "$KeepName" != "1" ]]; then
         echo "BOOT: Secure Boot requires signed BOOTX64.EFI and trusted Shim." >&2
         return 1
      fi
      if ! mokutil --test-key "$DerKey" >/dev/null 2>&1; then
         echo "BOOT: local signing certificate $DerKey is not yet enrolled as a MOK." >&2
         echo "BOOT: run sudo mokutil --import $DerKey, enroll at reboot, then rerun BOOT." >&2
         echo "BOOT: ESP contents and firmware BootOrder are unchanged." >&2
         return 1
      fi
      if ! sbverify --cert "$CertKey" "$BootDir/boot_$Platform.efi" >/dev/null 2>&1; then
         echo "BOOT: EFI signature verification failed; firmware unchanged." >&2
         return 1
      fi
   fi

   if [[ "$TargetDir" == "/EFI/InfiltratorOS/BOOT" ]] ; then
      if [[ -L "$InstallDir/EFI" || -L "$InstallDir/EFI/InfiltratorOS" ||
            -L "$InstallDir/$TargetDir" ]] ; then
         echo "Refusing to remove BOOT via an EFI symbolic link." >&2
         Problems=1
         return 1
      fi
      rm -rf -- "$InstallDir/$TargetDir" || {
         echo "Cannot clear the old BOOT installation." >&2
         Problems=1
         return 1
      }
      if [[ -e "$InstallDir/$TargetDir" || -L "$InstallDir/$TargetDir" ]] ; then
         echo "BOOT installation directory remains after cleanup; refusing installation." >&2
         Problems=1
         return 1
      fi
      echo "Cleared previous BOOT installation at ${InstallDir%/}${TargetDir}"
   fi
   CopyBootFiles
   AddBootEntry

   if [[ "$IsSecureBoot" == "1" && "$AlwaysYes" == "0" ]] ; then
      InstallSBKey
   fi
}

GetParams "$@"
if [[ $UID != 0 ]] ; then
   echo "Not running as root; attempting to elevate privileges via sudo...."
   if ! sudo "${BASH_SOURCE[0]}" "$@" ; then
      echo "This script must be run as root (or using sudo). Exiting!"
      exit 1
   else
      exit 0
   fi
fi
DeterminePlatform
CheckForFiles
case "$OSTYPE" in
   darwin*)
        if [[ "$ShimSource" != "none" ]] ; then
           echo "The --shim option is not supported on macOS! Exiting!"
           exit 1
        fi
        if [[ "$LocalKeys" != 0 ]] ; then
           echo "The --localkeys option is not supported on macOS! Exiting!"
           exit 1
        fi
        InstallOnOSX "$1"
        ;;
   linux*)
        InstallOnLinux
        ;;
   *)
        echo "Running on unknown OS; aborting!"
        if [[ "$InstallToEspOnMac" == 0 ]] ; then
           echo "The --notesp option is not supported on Linux! Exiting!"
           exit 1
        fi
esac
CreateBootCsvFile

# KNOWN CLEAN-SUCCESS FAILURE: Problems is only set to 1 by error branches.
# Under set -u, evaluating [[ $Problems ]] when it remains unset aborts the
# clean-success path. This records existing behaviour, not a repaired exit
# contract; explicit clean-exit and failure tests are still necessary.
InstallationFailed=0
if [[ $Problems ]] ; then
   InstallationFailed=1
   echo
   echo "ALERT:"
   echo "Installation has completed, but problems were detected. Review the output for"
   echo "error messages and take corrective measures as necessary. You may need to"
   echo "re-run this script or install manually before BOOT will work."
   echo
else
   echo
   echo "Installation has completed successfully."
   echo
fi

if [[ $UnmountEsp == '1' ]] ; then
   echo "Unmounting install dir"
   case "$OSTYPE" in
   darwin*)
      diskutil unmount "$InstallDir"
      ;;
   *)
      umount "$InstallDir"
      ;;
   esac
fi

if [[ "$InstallDir" == /tmp/boot_install ]] ; then

   rmdir "$InstallDir"
fi

exit "$InstallationFailed"
