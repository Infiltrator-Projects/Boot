# Official InfiltratorOS appearance, selected by boot.conf rather than
# hardcoded in the EFI executable. Paths are relative to BOOT's directory.
# Set an individual asset to 'none' to suppress it. You may substitute your
# own PNG/JPEG files; no alternative theme package is required.
theme_background themes/boot-luxury.png
theme_logo themes/boot-logo.png
# Optional custom themes can supply their own PNG/JPEG logo or disable it
# with theme_logo none; no text substitution is drawn for this default.
# theme_mark themes/boot-mark.png
# theme_underline themes/boot-underline.png
# Existing settings banner, banner_scale, icons_dir, selection_big,
# selection_small, font_body, font_bold and font_title remain supported.
font_body mb_corpo_s_text_regular.ttf
font_bold mb_corpo_s_text_bold.ttf
font_title mb_corpo_a_title_regular.ttf
# Reference layout: 144px OS icons on native 162px selection plates.
big_icon_size 144
small_icon_size 64

# BOOT runtime menu defaults and disabled example manual boot entries.
# timeout is a UI delay. use_nvram false applies to BOOT-managed runtime
# variables; it does NOT prohibit the native installer modifying BootOrder.
# dont_scan_files hides matching menu candidates; it does not remove the
# GRUB or fallback EFI executable or their independently selectable boot paths.
# dont_scan_volumes applies also to EFI driver connection and repeated raw
# filesystem probes, preventing stalls on explicitly excluded partitions.
# Match existing GPT partition labels or UUIDs, separated by commas. Keep
# this optional; a generic BOOT release must never hardcode test-disk labels.
# Example for an independently identified, slow removable test volume:
# dont_scan_volumes TEST_PARTITION_LABEL
# default_selection vmlinuz prefers a discovered direct Linux kernel; it
# must not restrict how many supported operating systems are discovered.
# Manual menuentry examples below are deliberately disabled, not boot probes.
# An active display entry is not proof of EFI-image authentication or OS boot.

# Record EFI driver connection and boot discovery diagnostics by default.
# Values above zero enable the UTF-16 boot.log beside the active boot.conf.
# An explicit log_level 0 disables logging when diagnostics are not required.
log_level 4

# Temporary graphical progress and detailed EFI controller/volume timing.
# Use 'startup_diagnostics off' to disable ALL extra startup instrumentation.
# This runtime switch lives only in boot.conf; no rebuild is required.
startup_diagnostics on

timeout 20

# Enumerate firmware boot entries before filesystem scans, so an installed
# Linux distribution remains selectable even if direct kernel discovery is
# unavailable on its filesystem. BOOT's own firmware entry is hidden to
# prevent a recursive menu option; Ubuntu, Windows and other OS entries remain.
scanfor f,i,e,o,m
# Look for Linux EFI-stub kernels (vmlinuz*, bzImage*, kernel*) on readable
# volumes, including a discovered read-only LVM filesystem. Listing a kernel
# does not substitute for its initrd or required root= command line options.
scan_all_linux_kernels true
dont_scan_firmware "BOOT Boot Manager"

use_nvram false

dont_scan_files +,grubx64.efi,EFI/BOOT/bootx64.efi

default_selection vmlinuz

menuentry Linux {
    icon EFI/BOOT/icons/os_linux.png
    volume 904404F8-B481-440C-A1E3-11A5A954E601
    loader bzImage-3.3.0-rc7
    initrd initrd-3.3.0.img
    options "ro root=UUID=5f96cafa-e0a7-4057-b18f-fa709db5b837"
    disabled
}

menuentry "Arch Linux" {
    icon     /EFI/BOOT/icons/os_arch.png
    volume   "Arch Linux"
    loader   /boot/vmlinuz-linux
    initrd   /boot/initramfs-linux.img
    options  "root=PARTUUID=5028fa50-0079-4c40-b240-abfaf28693ea rw add_efi_memmap"
    submenuentry "Boot using fallback initramfs" {
        initrd /boot/initramfs-linux-fallback.img
    }
    submenuentry "Boot to terminal" {
        add_options "systemd.unit=multi-user.target"
    }
    disabled
}

menuentry Ubuntu {
    loader /EFI/ubuntu/grubx64.efi
    icon /EFI/BOOT/icons/os_linux.png
    disabled
}

menuentry "ELILO" {
    loader \EFI\elilo\elilo.efi
    disabled
}

menuentry "Windows 7" {
    loader \EFI\Microsoft\Boot\bootmgfw.efi
    disabled
}

menuentry "Windows via shell script" {
    icon \EFI\BOOT\icons\os_win.png
    loader \EFI\tools\shell.efi
    options "fs0:\EFI\tools\launch_windows.nsh"
    disabled
}

menuentry "My macOS" {
    icon \EFI\BOOT\icons\os_mac.png
    volume "macOS boot"
    loader \System\Library\CoreServices\boot.efi
    disabled
}

menuentry "macOS via BootNext" {
    icon /EFI/BOOT/icons/os_mac.png
    firmware_bootnum 80
    disabled
}
