#!/bin/bash
# macOS EFI System Partition lookup/mount helper retained for BOOT
# compatibility. diskutil output, partition choice and mountpoint state are
# platform-specific; this helper must not be invoked as a generic Linux
# ESP discovery routine or to write other vendors' EFI directories.

# Locates or mounts an ESP using macOS disk utilities. When multiple ESPs
# exist, selecting the correct disk is a prerequisite to any safe install.
MountOSXESP() {

    Temp=$(mount | sed -n -E "/^(\/dev\/disk.*) on \/ \(.*$/s//\1/p")
    if [ "$Temp" ]; then
        Temp=$(diskutil list | grep " EFI " | grep -o 'disk.*' | head -n 1)
        if [ -z "$Temp" ]; then
            echo "Warning: root device doesn't have an EFI partition"
        fi
    else
        echo "Warning: root device could not be found"
    fi
    if [ -z "$Temp" ]; then
        Temp=$(diskutil list | sed -n -E '/^ *[0-9]+:[ ]+EFI EFI[ ]+[0-9.]+ [A-Z]+[ ]+(disk[0-9]+s[0-9]+)$/ { s//\1/p
                q
            }' )

        if [ -z "$Temp" ]; then
            echo "Could not find an EFI partition. Aborting!"
            exit 1
        fi
    fi
    # Temp now holds a diskutil device identifier. Reuse an existing df
    # mountpoint if present, otherwise attempt the mount under /Volumes/ESP.
    # The earlier selection takes the first matching EFI partition reported by
    # diskutil.
    Esp=/dev/$Temp
    echo "The ESP has been identified as $Esp; attempting to mount it...."

    Temp=$(df -P | grep "$Esp ")
    MountPoint=$(echo "$Temp" | cut -f 6- -d ' ')
    if [[ "$MountPoint" == '' ]] ; then
        if [[ $UID != 0 ]] ; then
            echo "You must run this program as root or using sudo! Exiting!"
            exit 1
        fi
        MountPoint="/Volumes/ESP"

        mkdir /Volumes/ESP &> /dev/null

        if  ! mount -t msdos "$Esp" $MountPoint ; then
            if ! mount -t hfs "$Esp" $MountPoint ; then
                printf "Unable to mount ESP!\n\n"
                exit 1
            fi
        fi
    fi
    echo "The ESP is mounted at $MountPoint"
}

case "$OSTYPE" in
    darwin*)
            MountOSXESP
            ;;
    *)
            echo "This script is meant to be run under OS X *ONLY*! Exiting!"
            exit
            ;;
esac
