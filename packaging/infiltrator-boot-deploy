#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Deliberate ESP deployment only: never register firmware entries or modify
# BootOrder. The package install itself does not touch the ESP.
set -euo pipefail
if [[ $# -lt 2 || $2 != --confirm ]]; then
    echo 'usage: sudo infiltrator-boot-deploy --install-new|--update-existing|--recover --confirm [MODULE.so ...]' >&2
    exit 2
fi
case "$1" in --install-new|--update-existing|--recover) ;; *) echo 'Invalid deployment mode' >&2; exit 2 ;; esac
if [[ $EUID -ne 0 ]]; then
    echo 'Run as root; the EFI System Partition is privileged storage.' >&2
    exit 1
fi
mode=$1
shift 2
for module; do
    [[ $module =~ ^/System/Filesystems/[A-Za-z0-9_-]+\.so$ && -f $module && ! -L $module ]] || {
        echo "Invalid independently installed filesystem module: $module" >&2; exit 1;
    }
    permissions=$(stat -c '%a %u' -- "$module") || exit 1
    read -r bits owner <<< "$permissions"
    [[ $owner == 0 ]] && (( (8#$bits & 022) == 0 )) || {
        echo "Unsafe filesystem module ownership or permissions: $module" >&2; exit 1;
    }
done
esp=/boot/efi
payload=/usr/lib/infiltrator-boot/EFI/BOOT
core=/usr/lib/infiltrator-boot/deploy-core
[[ -f "$core" && ! -L "$core" ]] || { echo 'Missing packaged BOOT deployment engine' >&2; exit 1; }
[[ -d "$esp" && ! -L "$esp" && ! -L "$esp/EFI" ]] || { echo 'EFI System Partition is missing or unsafe' >&2; exit 1; }
[[ "$(findmnt -rnM "$esp" -o FSTYPE)" == vfat ]] || {
    echo "EFI System Partition is not mounted as vfat at $esp; refusing write." >&2
    exit 1
}
# The released EXT4 reader requires a compatible on-disk layout. A mounted
# journal normally has needs_recovery set until the filesystem is unmounted.
# Check both Linux boot paths before replacing the old ESP reader.
check_ext4_volume() {
    local mount=$1 device type details line block_size= features= feature
    local volume
    volume=$(findmnt -nro SOURCE,FSTYPE -T "$mount") || return 1
    read -r device type <<< "$volume" || return 1
    [[ -n $type ]] || return 1
    if [[ $type != ext4 ]]; then return 0; fi
    [[ -b $device ]] || return 1
    details=$(LC_ALL=C tune2fs -l "$device") || return 1
    while IFS= read -r line; do
        case "$line" in
            "Block size:"*) read -r block_size <<< "${line#*:}" ;;
            "Filesystem features:"*) features=${line#*:} ;;
        esac
    done <<< "$details"
    [[ $block_size == 1024 || $block_size == 2048 || $block_size == 4096 ]] || return 1
    [[ " $features " == *" extent "* ]] || return 1
    local -a enabled
    read -r -a enabled <<< "$features"
    for feature in "${enabled[@]}"; do
        case "$feature" in
            has_journal|ext_attr|resize_inode|dir_index|sparse_super2|fast_commit|stable_inodes|orphan_file|\
            filetype|needs_recovery|extent|64bit|flex_bg|ea_inode|metadata_csum_seed|large_dir|\
            sparse_super|large_file|huge_file|dir_nlink|extra_isize|quota|metadata_csum|readonly|project|verity) ;;
            *) return 1 ;;
        esac
    done
}

if [[ $mode == --update-existing ]]; then
    for dir in drivers drivers_x64; do
        for driver in "$esp/EFI/InfiltratorBoot/$dir/"*; do
            name=${driver##*/}
            if [[ -f $driver && ${name,,} == ext4_x64.efi ]]; then
                if ! check_ext4_volume / || ! check_ext4_volume /boot; then
                    echo 'Boot deployment: EXT4 layout could not be qualified for the installed reader.' >&2
                    exit 77
                fi
                break 2
            fi
        done
    done
fi
exec /bin/bash "$core" "$mode" "$payload" "$esp" "$@"
